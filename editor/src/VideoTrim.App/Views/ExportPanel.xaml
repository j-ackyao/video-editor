<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VideoTrim.App.Views.ExportPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:conv="using:VideoTrim.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <StackPanel Spacing="10">

        <!-- Editable combos: pick a preset or type your own value. -->
        <ComboBox Header="Resolution (height, px)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  Tag="{Binding HeightField}"
                  SelectionChanged="OnSameAsSourceSelectionChanged"
                  ItemsSource="{Binding HeightField.Options}"
                  Text="{Binding HeightField.Text, Mode=TwoWay}" />

        <ComboBox Header="Frame rate (fps)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  Tag="{Binding FpsField}"
                  SelectionChanged="OnSameAsSourceSelectionChanged"
                  ItemsSource="{Binding FpsField.Options}"
                  Text="{Binding FpsField.Text, Mode=TwoWay}" />

        <TextBlock Text="Quality mode" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
        <RadioButton Content="Quality (CRF)"
                     IsChecked="{Binding IsQualityMode, Mode=TwoWay}" />
        <RadioButton Content="Target bitrate"
                     IsChecked="{Binding IsBitrateMode, Mode=TwoWay}" />
        <RadioButton Content="Target size"
                     IsChecked="{Binding IsTargetSizeMode, Mode=TwoWay}" />

        <!-- Quality slider -->
        <StackPanel Visibility="{Binding IsQualityMode, Converter={StaticResource BoolToVis}}" Spacing="2">
            <TextBlock Text="Better  ⟷  Smaller" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Slider Minimum="1" Maximum="51" Value="{Binding QualityCrf, Mode=TwoWay}" />
        </StackPanel>

        <!-- Bitrate -->
        <ComboBox Header="Video bitrate (kbps)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVis}}"
                  ItemsSource="{Binding BitrateField.Options}"
                  Text="{Binding BitrateField.Text, Mode=TwoWay}" />

        <!-- Target size -->
        <StackPanel Visibility="{Binding IsTargetSizeMode, Converter={StaticResource BoolToVis}}" Spacing="6">
            <ComboBox Header="Target size" IsEditable="True"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding TargetSizeField.Options}"
                      Text="{Binding TargetSizeField.Text, Mode=TwoWay}" />
            <InfoBar IsOpen="{Binding IsTargetSizeFeasible, Converter={StaticResource InverseBool}}"
                     Severity="Warning"
                     IsClosable="False"
                     Message="{Binding FeasibilityMessage}" />
        </StackPanel>

        <!-- Audio -->
        <TextBlock Text="Audio" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
        <CheckBox Content="Include audio"
                  IsChecked="{Binding IncludeAudio, Mode=TwoWay}"
                  IsEnabled="{Binding SourceHasAudio}" />
        <ComboBox Header="Audio bitrate (kbps)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding AudioBitrateField.Options}"
                  Text="{Binding AudioBitrateField.Text, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditAudioBitrate}" />
    </StackPanel>
</UserControl>
