<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VideoTrim.App.Views.GifPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:conv="using:VideoTrim.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <ComboBox Header="Resolution (height, px)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  Tag="{Binding HeightField}"
                  SelectionChanged="OnSameAsSourceSelectionChanged"
                  ItemsSource="{Binding HeightField.Options}"
                  Text="{Binding HeightField.Text, Mode=TwoWay}" />

        <ComboBox Header="Frame rate (fps)" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  Tag="{Binding FpsField}"
                  SelectionChanged="OnSameAsSourceSelectionChanged"
                  ItemsSource="{Binding FpsField.Options}"
                  Text="{Binding FpsField.Text, Mode=TwoWay}" />

        <TextBlock Text="Smaller  ⟷  More colors" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
        <Slider Minimum="2" Maximum="256" StepFrequency="1" Value="{Binding MaxColors, Mode=TwoWay}" />

        <ComboBox HorizontalAlignment="Stretch"
                  Header="Dithering"
                  ItemsSource="{Binding DitherOptions}"
                  SelectedItem="{Binding Dither, Mode=TwoWay}" />

        <CheckBox Content="Limit to a target size"
                  IsChecked="{Binding UseTargetSize, Mode=TwoWay}"
                  Margin="0,6,0,0" />
        <ComboBox Header="Target size" IsEditable="True"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding TargetSizeField.Options}"
                  Text="{Binding TargetSizeField.Text, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditTargetSize}" />
    </StackPanel>
</UserControl>
